# Application Settings
PROJECT_NAME="MSME Risk AI API"
API_V1_STR="/api"

# Database Configuration
# Supabase PostgreSQL connection string (Direct Port 5432 or Transaction Pooler Port 6543):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For local dev / testing fallback:
DATABASE_URL=sqlite:///./msme_risk.db

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Firebase Admin SDK Configuration (for production token verification)
# In development, tokens can be verified using Google public certs with project ID
FIREBASE_PROJECT_ID=msme-risk-ai
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Seed Demo Data toggle (false by default for clean user isolation)
SEED_DEMO_DATA=false

# Model Version Metadata
MODEL_VERSION=1.1.0
