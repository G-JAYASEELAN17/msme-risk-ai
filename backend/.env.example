# ==============================================================================
# MSME Risk AI - Backend Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO REPOSITORY
# ==============================================================================

# Application Environment (production / development / staging)
APP_ENV=production
DEBUG=false
PROJECT_NAME="MSME Risk AI API"
API_V1_STR="/api"

# Production Supabase PostgreSQL Connection URL
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require

# CORS Allowed Origins
# Example: https://msme-risk-ai.vercel.app,https://yourcustomdomain.com
CORS_ORIGINS=["https://msme-risk-ai.vercel.app"]

# Firebase Admin SDK Configuration (Production Token Verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Supabase Storage Configuration (Private Document Storage & Signed URLs)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=financial-documents

# Test Authentication Toggle
# CRITICAL SECURITY RULE: MUST BE false in production!
# When false, test_token:* headers are rejected with 401 Unauthorized.
ALLOW_TEST_AUTH=false

# Demo Data Seeding Toggle (false for strict user isolation)
SEED_DEMO_DATA=false

# ML Model Metadata & Versioning
MODEL_VERSION=1.1.0

# Document Intelligence & OCR Configuration
# Options: heuristic, mock, tesseract, cloud
OCR_PROVIDER=heuristic
# Path to local tesseract executable if OCR_PROVIDER=tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe | Linux: /usr/bin/tesseract
TESSERACT_CMD=
