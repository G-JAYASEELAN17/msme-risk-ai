# ==============================================================================
# MSME Risk AI - Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Base URL (Must include /api prefix, e.g. https://api.yourdomain.com/api)
# In development: http://localhost:8000/api
# In production: https://your-backend-service.onrender.com/api
VITE_API_BASE_URL=

# Firebase Client Configuration (From Firebase Console > Project Settings > General > Web Apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
